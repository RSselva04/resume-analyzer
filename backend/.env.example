# Django Settings
SECRET_KEY=django-insecure-resume-analyzer-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=resume_analyzer_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set to True if you want to test with SQLite before configuring PostgreSQL
USE_SQLITE=False

# Google Gemini API Key for AI Resume Analysis
GEMINI_API_KEY=your_gemini_api_key_here
